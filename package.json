{
  "name": "contact_map",
  "version": "1.0.0",
  "description": "Dieses Tool visualisiert die Akteure aus dem Excel-Datensatz `ADB_AquaRevier` auf einer interaktiven Karte sowie in **QGIS**. Es beinhaltet zusätzlich amtliche Geodaten des Landes NRW (Grenzen, Landkreise, Flüsse und Gewässer).",
  "main": "add_css.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "vendor": "node tools/build_vendor_assets.js",
    "check:links": "python tools/check_external_links.py",
    "test": "npm run vendor && npm run test:unit && playwright test",
    "test:unit": "node tests/unit/test_layer_control.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dtunder/adb_aquarevier_map.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Dtunder/adb_aquarevier_map/issues"
  },
  "homepage": "https://github.com/Dtunder/adb_aquarevier_map#readme",
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  },
  "dependencies": {
    "@popperjs/core": "2.11.8",
    "docx": "8.6.0",
    "html2canvas": "1.4.1",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "playwright": "^1.61.1",
    "tippy.js": "6.3.7"
  }
}
